# Zkopíruj na redmine.env a doplň. Skutečný soubor je v .gitignore.
REDMINE_URL=https://redmine.example.internal
REDMINE_API_KEY=

# Účet musí být SLUŽEBNÍ a zřetelně označený, ne osobní.
# Nesmí být správce a nesmí spravovat členství.

# Bez tohohle nastavení začne nástroj domýšlet povinná vlastní pole,
# a tím zapíše do evidence údaj, který nikdo nerozhodl.
REDMINE_AUTOFILL_REQUIRED_CUSTOM_FIELDS=false
